# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
server/node_modules
server/data/*.db

# testing
/coverage

# next.js
/.next/
.next/
/out/

# production
/build
server/dist

# misc
.DS_Store
*.pem

# config locale d'editeur
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ... mais on garde les modèles d'exemple versionnés
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rapports de couverture de tests
coverage/

# rapport HTML des résultats de tests (vitest)
html/
