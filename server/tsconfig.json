{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS : le package n'est pas en "type": "module", et Node doit pouvoir
    // exécuter `dist/index.js` directement (npm start). En ESNext, tsc émettait
    // des imports sans extension .js, que Node ne peut pas résoudre.
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
