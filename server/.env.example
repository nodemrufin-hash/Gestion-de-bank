# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Le fichier .env n'est PAS versionné (voir .gitignore).

# Clé API Claude d'Anthropic, utilisée par l'assistant IA.
# Obtenez-la sur https://console.anthropic.com (section API Keys).
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# --- Envoi d'emails (vérification du courriel via Gmail SMTP) ---
# Adresse Gmail expéditrice.
GMAIL_USER=votrecompte@gmail.com
# « Mot de passe d'application » Gmail (16 caractères) : activez la validation
# en 2 étapes sur votre compte Google, puis créez-en un dans
# Google Compte → Sécurité → Mots de passe d'application.
# Si ces deux variables sont absentes, le code s'affiche dans la console du
# serveur au lieu d'être envoyé par email (mode démonstration).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
